rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ───────────────────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    function memberOf(orgId) {
      return signedIn()
        && request.auth.token.organizationId == orgId;
    }

    function roleAtLeast(role) {
      return signedIn() && (
        (role == 'admin'
          && request.auth.token.role == 'admin') ||
        (role == 'manager'
          && request.auth.token.role in ['manager', 'admin']) ||
        (role == 'supervisor'
          && request.auth.token.role in ['supervisor', 'manager', 'admin']) ||
        (role == 'cashier'
          && request.auth.token.role in ['cashier', 'supervisor', 'manager', 'admin'])
      );
    }

    // ─── Organizations ──────────────────────────────────────────────

    match /organizations/{orgId} {
      allow read: if memberOf(orgId);
      allow write: if false;

      // ─── Products ────────────────────────────────────────────────

      match /products/{productId} {
        allow read: if memberOf(orgId);
        allow create, update: if memberOf(orgId)
          && roleAtLeast('manager');
        allow delete: if false;
      }

      // ─── Transactions (immutable after creation) ─────────────────

      match /transactions/{transactionId} {
        allow read: if memberOf(orgId)
          && roleAtLeast('cashier');
        allow create: if memberOf(orgId)
          && roleAtLeast('cashier')
          && request.resource.data.organizationId == orgId
          && request.resource.data.cashierId == request.auth.uid
          && request.resource.data.totalFCFA is int
          && request.resource.data.status == 'completed';
        allow update, delete: if false;
      }

      // ─── Staff ───────────────────────────────────────────────────

      match /staff/{staffId} {
        allow read: if memberOf(orgId)
          && roleAtLeast('manager');
        allow write: if false;
      }

      // ─── Inventory Adjustments ───────────────────────────────────

      match /inventory_adjustments/{adjustmentId} {
        allow read: if memberOf(orgId)
          && roleAtLeast('manager');
        allow create: if memberOf(orgId)
          && roleAtLeast('supervisor')
          && request.resource.data.organizationId == orgId
          && request.resource.data.performedBy == request.auth.uid;
        allow update, delete: if false;
      }

      // ─── Daily Reports ───────────────────────────────────────────

      match /daily_reports/{reportDate} {
        allow read: if memberOf(orgId)
          && roleAtLeast('cashier');
        allow create, update: if memberOf(orgId)
          && roleAtLeast('manager');
        allow delete: if false;
      }

      // ─── Catch-all deny inside org ───────────────────────────────

      match /{document=**} {
        allow read, write: if false;
      }
    }

    // ─── Sync Queue (offline transactions) ──────────────────────────

    match /sync_queue/{deviceId}/pending/{localId} {
      allow read, write: if signedIn()
        && request.auth.token.deviceId == deviceId;
    }

    // ─── Global catch-all deny ───────────────────────────────────────

    match /{document=**} {
      allow read, write: if false;
    }
  }
}